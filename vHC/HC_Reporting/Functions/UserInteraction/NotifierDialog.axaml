<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeeamHealthCheck.Functions.UserInteraction.NotifierDialog"
        Width="440"
        SizeToContent="Height"
        MaxHeight="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto">
        <ScrollViewer Grid.Row="0" MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="MessageText" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Name="NoButton" Content="No" Click="No_Click" IsVisible="False" />
            <Button Name="YesOkButton" Content="OK" Click="YesOk_Click" />
        </StackPanel>
    </Grid>
</Window>
