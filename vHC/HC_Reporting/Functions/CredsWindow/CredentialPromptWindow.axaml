<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeeamHealthCheck.Functions.CredsWindow.CredentialPromptWindow"
        Title="Authentication Required"
        Height="320"
        Width="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Styles>
        <Style Selector="Button.modern">
            <Setter Property="Background" Value="#00B336" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.modern:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#009E2F" />
        </Style>
        <Style Selector="Button.modern:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#008A28" />
        </Style>

        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D0D0D0" />
        </Style>
        <Style Selector="Button.cancel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0C0C0" />
        </Style>

        <Style Selector="TextBox.modern">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <!-- Explicit, not inherited: this window is entirely hardcoded-light (no
                 DynamicResource anywhere) and was never meant to pick up app-level
                 theming. Without this, Foreground falls through to App.axaml's global
                 TextBox.modern style (added for the main window's theme port), which
                 resolves to near-white PrimaryTextBrush in Dark mode - invisible
                 against this dialog's hardcoded white Background above. -->
            <Setter Property="Foreground" Value="#333333" />
        </Style>
        <Style Selector="TextBox.modern:focus">
            <Setter Property="BorderBrush" Value="#00B336" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="#00B336" Height="80" VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="🔐 Authentication Required"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="White" />
                <TextBlock x:Name="ServerText"
                          Text="Please enter your credentials"
                          FontSize="13"
                          Foreground="#E0F7E9"
                          Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Border Margin="0,80,0,0" Background="White">
            <Grid Margin="30,25,30,25" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <TextBlock Text="Username"
                          Grid.Row="0"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#333333"
                          Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox"
                        Grid.Row="1"
                        Classes="modern"
                        Margin="0,0,0,18" />

                <TextBlock Text="Password"
                          Grid.Row="2"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#333333"
                          Margin="0,0,0,6" />
                <TextBox x:Name="PasswordBox"
                        Grid.Row="3"
                        Classes="modern"
                        PasswordChar="*"
                        Margin="0,0,0,18" />

                <TextBlock Grid.Row="4"
                          Text="Credentials are stored in memory for this session only"
                          FontSize="11"
                          Foreground="#888888"
                          FontStyle="Italic"
                          VerticalAlignment="Top"
                          Margin="0,0,0,15" />

                <StackPanel Grid.Row="5"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Spacing="10">
                    <Button Content="Cancel"
                           Width="90"
                           Classes="cancel"
                           IsCancel="True"
                           Click="Cancel_Click" />
                    <Button Content="Connect"
                           Width="90"
                           Classes="modern"
                           IsDefault="True"
                           Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
